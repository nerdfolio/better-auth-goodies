{
	"name": "@nerdfolio/ba-guest-list",
	"version": "0.1.6",
	"description": "Similar to anonymous, but with a name that must be on a guest list. Useful for testing or demo with fixed logins",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/nerdfolio/better-auth-goodies.git",
		"directory": "packages/ba-guest-list"
	},
	"type": "module",
	"exports": {
		".": {
			"import": {
				"types": "./dist/index.d.mts",
				"default": "./dist/index.mjs"
			},
			"require": {
				"types": "./dist/index.d.cts",
				"default": "./dist/index.cjs"
			}
		}
	},
	"files": [
		"dist"
	],
	"scripts": {
		"build": "tsdown",
		"dev": "tsdown --watch",
		"clean": "rm -rf dist",
		"test": "vitest run",
		"test:watch": "vitest",
		"test:coverage": "vitest run --coverage",
		"typecheck": "tsc --noEmit",
		"lint": "biome check .",
		"format": "biome check --write .",
		"prepare": "pnpm build",
		"prepublishOnly": "pnpm run lint && pnpm run typecheck && pnpm test"
	},
	"keywords": [
		"better-auth",
		"better-auth plugin",
		"guest login",
		"demo login",
		"anonymous login",
		"auth testing"
	],
	"author": "taivo@github",
	"license": "ISC",
	"engines": {
		"node": ">=22"
	},
	"publishConfig": {
		"access": "public"
	},
	"devDependencies": {
		"@types/lodash-es": "catalog:",
		"@vitest/coverage-v8": "catalog:",
		"better-auth": "catalog:",
		"tsdown": "catalog:",
		"typescript": "catalog:",
		"vitest": "catalog:"
	},
	"peerDependencies": {
		"better-auth": "catalog:"
	},
	"dependencies": {
		"lodash-es": "catalog:",
		"zod": "catalog:"
	}
}
